# Bulk single-host deployment example
# Copy this file to .env.bulk before using docker compose for the bulk stack.
#
# Host credentials defined here are bootstrap-only. Do not commit real values,
# and rotate any temporary passwords after the first successful deployment.
#
# This topology keeps ClickHouse and the bulk API private to Docker Compose.
# Host operators should use `docker compose exec ...` (or the package wrappers)
# for ingest, bulk load, and direct bulk API health checks instead of host
# networking or host-installed Node tooling.
# The bootstrap script can also assign the generated `.env.bulk` file and
# snapshot root to an operator account via `OPERATOR_USER` / `OPERATOR_GROUP`.

# Host path that stores monthly snapshot artifacts for the bulk pipeline.
BULK_SNAPSHOT_STORAGE_PATH=/var/lib/tech-stack-dashboard/bulk-snapshots

# Snapshot identifier that later ingest/query tasks will treat as active.
BULK_ACTIVE_SNAPSHOT_MONTH=2026-05

# ClickHouse connection settings for services running inside Docker Compose.
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=tech_stack_bulk
CLICKHOUSE_USER=bulk_app
CLICKHOUSE_PASSWORD=replace-with-bootstrap-password

# Hono bulk API bind settings inside the container network.
HONO_HOST=0.0.0.0
HONO_PORT=8787

# Dashboard server-side base URL for talking to the private Hono bulk API.
DASHBOARD_BULK_API_BASE_URL=http://bulk-api:8787

# Public host port for the dashboard container.
DASHBOARD_PORT=3000
